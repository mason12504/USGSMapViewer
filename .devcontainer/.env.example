# Copy to .devcontainer/.env (gitignored) on your PC. Docker Compose reads it
# automatically. Only needed for the opt-in live API server (api-real).
#
# Your private folder, holding SECRETS.env. Forward slashes work on Windows.
MAPPARSER_PRIVATE_DIR=C:/Users/YOU/mapparser-private

# Optional: record live API responses so they can become mocks.
# MAPPARSER_RECORD_DIR=/app/fixtures/_recorded
